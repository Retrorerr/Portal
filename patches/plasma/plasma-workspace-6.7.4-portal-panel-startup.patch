     qunsetenv("QT_WAYLAND_RECONNECT");
     QApplication app(argc, argv);

+    if (qEnvironmentVariableIntValue("PORTAL_EVENT_LOOP_TRACE") > 0) {
+        auto lastTick = QElapsedTimer();
+        lastTick.start();
+        bool haveTick = false;
+        auto *watchdog = new QTimer(&app);
+        watchdog->setTimerType(Qt::PreciseTimer);
+        watchdog->setInterval(16);
+        QObject::connect(watchdog, &QTimer::timeout, &app, [&lastTick, &haveTick]() {
+            const qint64 gap = lastTick.restart();
+            if (!haveTick) {
+                haveTick = true;
+                return;
+            }
+            if (gap >= 100) {
+                qCWarning(PLASMASHELL).noquote() << "PORTAL_EVENT_LOOP timestamp_ms=" << QDateTime::currentMSecsSinceEpoch()
+                                                  << "event=stall" << "gap_ms=" << gap;
+            }
+        });
+        watchdog->start();
+    }
+
     qunsetenv("QT_WAYLAND_DISABLE_FIXED_POSITIONS");
     qputenv("QT_WAYLAND_RECONNECT", "1");

