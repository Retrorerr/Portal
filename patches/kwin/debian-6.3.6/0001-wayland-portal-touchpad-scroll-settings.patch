+
+void WaylandInputDevice::setScrollFactor(qreal factor)
+{
+    if (m_scrollFactor == factor) {
+        return;
+    }
+    m_scrollFactor = factor;
+    m_config.writeEntry("ScrollFactor", factor);
+    m_config.sync();
+    Q_EMIT scrollFactorChanged();
+}
