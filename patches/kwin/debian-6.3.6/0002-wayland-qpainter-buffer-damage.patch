diff --git a/src/backends/wayland/qpainter_buffer_damage.h b/src/backends/wayland/qpainter_buffer_damage.h
new file mode 100644
--- /dev/null
+++ b/src/backends/wayland/qpainter_buffer_damage.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <QRectF>
+#include <QRegion>
+#include <QSize>
+
+namespace KWin::Wayland
+{
+// Match ItemRendererQPainter::beginFrame: setWindow(renderRect().toRect())
+// maps the logical clip to the complete QImage viewport. Do not substitute
+// wl_surface's integer buffer scale or round the rectangle inward.
+inline QRegion qpainterBufferDamage(const QRegion &logicalDamage, const QSize &window, const QSize &buffer)
+{
+    const QRect bounds(QPoint(0, 0), buffer);
+    if (window.isEmpty() || buffer.isEmpty()) {
+        return bounds;
+    }
+    const qreal sx = qreal(buffer.width()) / window.width();
+    const qreal sy = qreal(buffer.height()) / window.height();
+    QRegion result;
+    for (const QRect &rect : logicalDamage) {
+        result += QRectF(rect.x() * sx, rect.y() * sy,
+                         rect.width() * sx, rect.height() * sy)
+                      .toAlignedRect().intersected(bounds);
+    }
+    return result;
+}
+}
