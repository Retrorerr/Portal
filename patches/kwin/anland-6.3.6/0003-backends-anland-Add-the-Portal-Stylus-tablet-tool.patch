+class AnlandTabletTool : public InputDeviceTabletTool
+{
+    Q_OBJECT
+
+public:
+    AnlandTabletTool(Type type, quint64 serial, QObject *parent = nullptr);
+
+    quint64 serialId() const override;
+    quint64 uniqueId() const override;
+    Type type() const override;
+    QList<Capability> capabilities() const override;
+
+private:
+    Type m_type;
+    quint64 m_serial;
+};
+
+// The Portal Stylus: Android's stylus as a tablet tool, so clients that bind
+// zwp_tablet_v2 get pressure, tilt, hover distance and the eraser. The host
+// sends absolute pen state; the transitions KWin expects (proximity in/out,
+// tip down/up, button press/release) are derived here, so a lost host event
+// can never leave the pen stuck down. Leaving proximity is held back briefly:
+// Android reports the pen out of hover range just before it touches down and
+// after it lifts, and those gaps must not flicker the tool in and out.
+class AnlandTabletDevice : public InputDevice
+{
+    Q_OBJECT
+
+public:
+    explicit AnlandTabletDevice(QObject *parent = nullptr);
+
+    QString name() const override;
+    bool isEnabled() const override;
+    void setEnabled(bool enabled) override;
+
+    bool isKeyboard() const override;
+    bool isPointer() const override;
+    bool isTouchpad() const override;
+    bool isTouch() const override;
+    bool isTabletTool() const override;
+    bool isTabletPad() const override;
+    bool isTabletModeSwitch() const override;
+    bool isLidSwitch() const override;
+
+    // Latch tilt (degrees) and hover distance (0..1) for the next toolState().
+    void setAxes(qreal tiltX, qreal tiltY, qreal distance);
+    // Commit one pen sample (TABLET_TOOL_* flags).
+    void toolState(const QPointF &position, qreal pressure, quint32 flags);
+    // Lift the pen and leave proximity, e.g. when the consumer goes away.
+    void cancel();
+
+private:
+    AnlandTabletTool *activeTool();
+    void leaveProximity(std::chrono::microseconds time);
+    void endClientHover(std::chrono::microseconds time);
+
+    AnlandTabletTool m_pen;
+    AnlandTabletTool m_eraser;
+    QTimer m_leaveTimer;
+    bool m_enabled = true;
+    bool m_near = false;
+    bool m_down = false;
+    bool m_eraserActive = false;
+    quint32 m_buttons = 0;
+    QPointF m_position;
+    qreal m_tiltX = 0;
+    qreal m_tiltY = 0;
+    qreal m_distance = 0;
+};
+
 class AnlandInputBackend : public InputBackend
 {
     Q_OBJECT
diff --git a/src/backends/anland/protocol.h b/src/backends/anland/protocol.h
index 726503a..e980595 100644
--- a/src/backends/anland/protocol.h
+++ b/src/backends/anland/protocol.h
@@ -73,6 +73,17 @@ struct buf_info {
 #define INPUT_TYPE_POINTER_AXIS_FINGER 13
 /* Portal: terminates an active finger scroll stream, { axis }. */
 #define INPUT_TYPE_POINTER_AXIS_STOP 14
+/* Portal Stylus. One pen sample is two events: TABLET_TOOL_AXES latches tilt
+ * and hover distance, then TABLET_TOOL commits position, pressure and the
+ * TABLET_TOOL_* state flags. */
+#define INPUT_TYPE_TABLET_TOOL_AXES 15
+#define INPUT_TYPE_TABLET_TOOL      16
+
+#define TABLET_TOOL_IN_PROXIMITY (1u << 0)
+#define TABLET_TOOL_TIP_DOWN     (1u << 1)
+#define TABLET_TOOL_ERASER       (1u << 2)
+#define TABLET_TOOL_BUTTON1      (1u << 3) /* BTN_STYLUS */
+#define TABLET_TOOL_BUTTON2      (1u << 4) /* BTN_STYLUS2 */
 
 /* Service identifiers used by OUTPUT_TYPE_RESOURCES_REQUEST / INPUT_TYPE_RESOURCE. */
 #define SERVICE_TYPE_CAMERA 1
@@ -109,6 +120,18 @@ struct InputEvent {
             float    value;
             int32_t  discrete;
         } pointer_axis;
+        struct {
+            float    tilt_x;   /* degrees, -90..90, positive towards +x */
+            float    tilt_y;   /* degrees, -90..90, positive towards +y */
+            float    distance; /* 0 (touching) .. 1 (edge of hover range) */
+            uint32_t reserved;
+        } tablet_axes;
+        struct {
+            float    x;
+            float    y;
+            float    pressure; /* 0..1 */
+            uint32_t flags;    /* TABLET_TOOL_* */
+        } tablet_tool;
         struct {
             uint32_t refresh_mhz; // current display refresh rate, milli-Hz
         } display;
