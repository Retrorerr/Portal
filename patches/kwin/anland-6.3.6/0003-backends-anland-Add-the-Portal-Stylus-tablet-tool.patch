+// evdev codes for the stylus barrel buttons, as libinput reports them.
+static constexpr quint32 BtnStylus = 0x14b;
+static constexpr quint32 BtnStylus2 = 0x14c;
+
+AnlandTabletTool::AnlandTabletTool(Type type, quint64 serial, QObject *parent)
+    : InputDeviceTabletTool(parent)
+    , m_type(type)
+    , m_serial(serial)
+{
+}
+
+quint64 AnlandTabletTool::serialId() const
+{
+    return m_serial;
+}
+
+quint64 AnlandTabletTool::uniqueId() const
+{
+    return m_serial;
+}
+
+InputDeviceTabletTool::Type AnlandTabletTool::type() const
+{
+    return m_type;
+}
+
+QList<InputDeviceTabletTool::Capability> AnlandTabletTool::capabilities() const
+{
+    return {Pressure, Tilt, Distance};
+}
+
+AnlandTabletDevice::AnlandTabletDevice(QObject *parent)
+    : InputDevice(parent)
+    , m_pen(InputDeviceTabletTool::Pen, 1)
+    , m_eraser(InputDeviceTabletTool::Eraser, 2)
+{
+    m_leaveTimer.setSingleShot(true);
+    m_leaveTimer.setInterval(50);
+    connect(&m_leaveTimer, &QTimer::timeout, this, [this]() {
+        leaveProximity(now());
+    });
+}
+
+QString AnlandTabletDevice::name() const
+{
+    return QStringLiteral("Portal Stylus");
+}
+
+bool AnlandTabletDevice::isEnabled() const
+{
+    return m_enabled;
+}
+
+void AnlandTabletDevice::setEnabled(bool enabled)
+{
+    m_enabled = enabled;
+}
+
+bool AnlandTabletDevice::isKeyboard() const
+{
+    return false;
+}
+
+bool AnlandTabletDevice::isPointer() const
+{
+    return false;
+}
+
+bool AnlandTabletDevice::isTouchpad() const
+{
+    return false;
+}
+
+bool AnlandTabletDevice::isTouch() const
+{
+    return false;
+}
+
+bool AnlandTabletDevice::isTabletTool() const
+{
+    return true;
+}
+
+bool AnlandTabletDevice::isTabletPad() const
+{
+    return false;
+}
+
+bool AnlandTabletDevice::isTabletModeSwitch() const
+{
+    return false;
+}
+
+bool AnlandTabletDevice::isLidSwitch() const
+{
+    return false;
+}
+
+void AnlandTabletDevice::setAxes(qreal tiltX, qreal tiltY, qreal distance)
+{
+    m_tiltX = tiltX;
+    m_tiltY = tiltY;
+    m_distance = distance;
+}
+
+AnlandTabletTool *AnlandTabletDevice::activeTool()
+{
+    return m_eraserActive ? &m_eraser : &m_pen;
+}
+
+void AnlandTabletDevice::toolState(const QPointF &position, qreal pressure, quint32 flags)
+{
+    const auto time = now();
+    const bool down = flags & TABLET_TOOL_TIP_DOWN;
+    const bool near = down || (flags & TABLET_TOOL_IN_PROXIMITY);
+    const bool eraser = flags & TABLET_TOOL_ERASER;
+    const quint32 buttons = flags & (TABLET_TOOL_BUTTON1 | TABLET_TOOL_BUTTON2);
+
+    if (!near) {
+        if (m_near) {
+            // Lift the tip and release buttons now; leave proximity later
+            // unless the pen comes straight back.
+            toolState(m_position, 0, TABLET_TOOL_IN_PROXIMITY | (m_eraserActive ? TABLET_TOOL_ERASER : 0));
+            m_leaveTimer.start();
+        }
+        return;
+    }
+    m_leaveTimer.stop();
+    // Flipping the pen is a different tool: the old one leaves first.
+    if (m_near && eraser != m_eraserActive) {
+        leaveProximity(time);
+    }
+
+    m_position = position;
+    if (!down) {
+        pressure = 0;
+    }
+    if (!m_near) {
+        m_near = true;
+        m_eraserActive = eraser;
+        Q_EMIT tabletToolProximityEvent(position, pressure, m_tiltX, m_tiltY, 0, m_distance, false, true, activeTool(), time, this);
+    }
+    if (down != m_down) {
+        m_down = down;
+        Q_EMIT tabletToolTipEvent(position, pressure, m_tiltX, m_tiltY, 0, m_distance, down, true, activeTool(), time, this);
+    } else {
+        Q_EMIT tabletToolAxisEvent(position, pressure, m_tiltX, m_tiltY, 0, m_distance, down, true, activeTool(), time, this);
+    }
+
+    const quint32 changed = buttons ^ m_buttons;
+    m_buttons = buttons;
+    if (changed & TABLET_TOOL_BUTTON1) {
+        Q_EMIT tabletToolButtonEvent(BtnStylus, buttons & TABLET_TOOL_BUTTON1, activeTool(), time, this);
+    }
+    if (changed & TABLET_TOOL_BUTTON2) {
+        Q_EMIT tabletToolButtonEvent(BtnStylus2, buttons & TABLET_TOOL_BUTTON2, activeTool(), time, this);
+    }
+}
+
+void AnlandTabletDevice::leaveProximity(std::chrono::microseconds time)
+{
+    m_leaveTimer.stop();
+    if (!m_near) {
+        return;
+    }
+    if (m_down) {
+        m_down = false;
+        Q_EMIT tabletToolTipEvent(m_position, 0, m_tiltX, m_tiltY, 0, m_distance, false, true, activeTool(), time, this);
+    }
+    if (m_buttons & TABLET_TOOL_BUTTON1) {
+        Q_EMIT tabletToolButtonEvent(BtnStylus, false, activeTool(), time, this);
+    }
+    if (m_buttons & TABLET_TOOL_BUTTON2) {
+        Q_EMIT tabletToolButtonEvent(BtnStylus2, false, activeTool(), time, this);
+    }
+    m_buttons = 0;
+    m_near = false;
+    endClientHover(time);
+    Q_EMIT tabletToolProximityEvent(m_position, 0, m_tiltX, m_tiltY, 0, m_distance, false, false, activeTool(), time, this);
+}
+
+void AnlandTabletDevice::endClientHover(std::chrono::microseconds time)
+{
+    // Qt and Xwayland turn pen hover into pointer hover and never end it on
+    // proximity out, so the tooltip under the pen would stay up until the
+    // next hover. Moving the tool off its surface first ends the hover the way
+    // a mouse leaving would.
+    TabletSeatV2Interface *seat = waylandServer()->tabletManagerV2()->seat(waylandServer()->seat());
+    TabletToolV2Interface *tool = seat ? seat->tool(activeTool()) : nullptr;
+    if (!tool || !tool->currentSurface() || !tool->isClientSupported()) {
+        return;
+    }
+    tool->sendMotion(QPointF(-1, -1));
+    tool->sendFrame(std::chrono::duration_cast<std::chrono::milliseconds>(time).count());
+}
+
+void AnlandTabletDevice::cancel()
+{
+    leaveProximity(now());
+}
+
 AnlandInputBackend::AnlandInputBackend(AnlandBackend *backend)
     : m_backend(backend)
 {
@@ -289,6 +494,9 @@ void AnlandInputBackend::initialize()
             Q_EMIT deviceAdded(device->sysName());
         }
     }
+    if (AnlandTabletDevice *tablet = m_backend->tabletDevice()) {
+        Q_EMIT deviceAdded(tablet);
+    }
 }
 
