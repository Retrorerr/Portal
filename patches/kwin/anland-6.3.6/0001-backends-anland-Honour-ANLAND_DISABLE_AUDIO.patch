From ec40c62185b4ffb0e11eccf69a5ea56b5cc7c2f1 Mon Sep 17 00:00:00 2001
From: Portal <masobazee@gmail.com>
Date: Sat, 26 Sep 2026 23:12:02 +0100
Subject: [PATCH 1/2] backends/anland: Honour ANLAND_DISABLE_AUDIO

Backport of upstream Anland 9f3ae3c. A consumer without an audio service
(Portal plays audio through its own PipeWire/AAudio bridge) sets
ANLAND_DISABLE_AUDIO=1 so KWin does not create the anland-speaker and
anland-mic devices, which WirePlumber could otherwise pick as the
default sink and silence the desktop.
---
 src/backends/anland/anland_backend.cpp | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/backends/anland/anland_backend.cpp b/src/backends/anland/anland_backend.cpp
index 1fa109f..d571283 100644
--- a/src/backends/anland/anland_backend.cpp
+++ b/src/backends/anland/anland_backend.cpp
@@ -164,8 +164,16 @@ bool AnlandBackend::initialize()
     // so Linux apps never see the devices appear/disappear as the consumer comes and
     // goes. The socket fd is attached later (onReconnectTimer) and detached in
     // enterFallback(). Audio is non-critical, so a failure here is not fatal.
-    if (anland_audio_start() < 0) {
+    //
+    // ANLAND_DISABLE_AUDIO=1 skips the audio engine entirely: the anland-audio
+    // PipeWire thread-loop (and the anland-speaker/anland-mic virtual devices) is
+    // never created, for consumers that have no audio service of their own.
+    const bool disableAudio = qEnvironmentVariableIsSet("ANLAND_DISABLE_AUDIO")
+        && qEnvironmentVariableIntValue("ANLAND_DISABLE_AUDIO") != 0;
+    if (!disableAudio && anland_audio_start() < 0) {
         qCWarning(KWIN_ANLAND) << "failed to start audio engine; continuing without audio";
+    } else if (disableAudio) {
+        qCInfo(KWIN_ANLAND) << "anland audio engine disabled by ANLAND_DISABLE_AUDIO";
     }
 
     // The camera engine is NOT started here: its PipeWire thread-loop is brought up
