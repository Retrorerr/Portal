+// The consumer stamps the input it forwards with the time Android sampled it.
+// Stamping events when KWin reads them instead made their spacing jitter by as
+// much as a composite takes, which clients (and the X11 fling below) read as
+// changes in finger speed. Android uses the same CLOCK_MONOTONIC as
+// steady_clock; anything implausible falls back to the read time.
+static std::optional<std::chrono::microseconds> s_eventTime;
+static std::chrono::microseconds s_lastEventTime{0};
+static constexpr std::chrono::microseconds MaxEventAge = std::chrono::milliseconds(100);
+
+void setAnlandEventTime(std::optional<std::chrono::nanoseconds> time)
+{
+    if (time) {
+        s_eventTime = std::chrono::duration_cast<std::chrono::microseconds>(*time);
+    } else {
+        s_eventTime.reset();
+    }
+}
+
+// The time of the event being processed. Each stamp applies to one event, and
+// times never go backwards, whichever way an event was stamped.
+static std::chrono::microseconds eventTime()
+{
+    const auto current = now();
+    auto time = s_eventTime.value_or(current);
+    s_eventTime.reset();
+    if (time > current || current - time > MaxEventAge) {
+        time = current;
+    }
+    time = std::max(time, s_lastEventTime);
+    s_lastEventTime = time;
+    return time;
+}
