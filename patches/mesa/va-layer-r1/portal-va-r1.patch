+static int
+tva_av1_hint_lookup(const struct tva_codec *c,
+                    const struct pipe_video_buffer *buffer)
+{
+    const struct tva_av1_hint *hint = tva_av1_hint_find(c, buffer);
+    return hint ? hint->order_hint : -1;
