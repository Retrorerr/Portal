+/* The VA frontend creates the decoder at the first picture, so without this
+ * check a missing daemon (not started, restarting, or a sandbox with its own
+ * /tmp) surfaces mid-decode and clients never take their software path.
+ * Probe the endpoint at driver init instead: a connect that is refused or
+ * finds no socket fails vaInitialize. */
+bool tva_bridge_daemon_reachable(void)
+{
+    char buf[300];
+    const char *ep = tva_default_endpoint(buf, sizeof(buf));
+    struct sockaddr_un ua;
+    if (!ep || !*ep || strlen(ep) >= sizeof(ua.sun_path))
+        return true;   /* abstract or unusual endpoint: leave it to the session */
+
+    int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+    if (fd < 0)
+        return true;
+    memset(&ua, 0, sizeof(ua));
+    ua.sun_family = AF_UNIX;
+    memcpy(ua.sun_path, ep, strlen(ep));
+    int r = connect(fd, (struct sockaddr *)&ua, sizeof(ua));
+    int e = errno;
+    close(fd);
+    if (r == 0 || e == EINPROGRESS || e == EAGAIN)
+        return true;
+    fprintf(stderr, "tva: no termux-va daemon at %s (%s); VA-API unavailable\n",
+            ep, strerror(e));
+    return false;
+}
