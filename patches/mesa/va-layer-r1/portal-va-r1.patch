+/* ---------------------------------------------------------- global motion */
+
+const int32_t dmd_av1_gm_default[6] = { 0, 0, 1 << 16, 0, 0, 1 << 16 };
+
+/* Inverse of inverse_recenter() (specification 5.9.28). */
+static uint32_t recenter_nonneg(uint32_t r, uint32_t v)
+{
+    if (v > (r << 1))
+        return v;
+    if (v >= r)
+        return (v - r) << 1;
+    return ((r - v) << 1) - 1;
+}
+
+/* Inverse of decode_subexp() (specification 5.9.27). */
+static void put_subexp(struct dmd_bitwriter *bw, uint32_t v, uint32_t num_syms)
+{
+    uint32_t i = 0, mk = 0;
+    const uint32_t k = 3;
+    for (;;) {
+        const uint32_t b2 = i ? k + i - 1 : k;
+        const uint32_t a = 1u << b2;
+        if (num_syms <= mk + 3 * a) {
+            dmd_av1_put_ns(bw, v - mk, num_syms - mk);
+            return;
+        }
+        const int more = v >= mk + a;
+        dmd_bw_put_flag(bw, more);
+        if (!more) {
+            dmd_bw_put_bits(bw, v - mk, (int)b2);
+            return;
+        }
+        i++;
+        mk += a;
+    }
+}
+
+/* Inverse of read_global_param() (specification 5.9.25). */
+static void put_global_param(struct dmd_bitwriter *bw, int type, int idx,
+                             const int32_t *params, const int32_t *prev,
+                             int hp)
+{
+    int abs_bits = 12, prec_bits = 15;        /* GM_ABS_ALPHA / GM_ALPHA_PREC */
+    if (idx < 2) {
+        if (type == 1) {                      /* TRANSLATION */
+            abs_bits = 9 - !hp;
+            prec_bits = 3 - !hp;
+        } else {
+            abs_bits = 12;
+            prec_bits = 6;
+        }
+    }
+    const int prec_diff = 16 - prec_bits;     /* WARPEDMODEL_PREC_BITS */
+    const int32_t round = (idx % 3) == 2 ? (1 << 16) : 0;
+    const int32_t sub = (idx % 3) == 2 ? (1 << prec_bits) : 0;
+    const int32_t mx = 1 << abs_bits;
+    const int32_t r = (prev[idx] >> prec_diff) - sub;
+    int32_t coded = (params[idx] - round) >> prec_diff;
+    if (coded < -mx)
+        coded = -mx;
+    if (coded > mx)
+        coded = mx;
+
+    /* decode_signed_subexp_with_ref(-mx, mx + 1, r) */
+    const uint32_t n = (uint32_t)(2 * mx + 1);
+    const uint32_t x = (uint32_t)(coded + mx);
+    const uint32_t rr = (uint32_t)(r + mx);
+    uint32_t v;
+    if ((rr << 1) <= n)
+        v = recenter_nonneg(rr, x);
+    else
+        v = recenter_nonneg(n - 1 - rr, n - 1 - x);
+    put_subexp(bw, v, n);
+}
+
+static void put_global_motion(struct dmd_bitwriter *bw,
+                              const VAWarpedMotionParamsAV1 *wm,
+                              const int32_t *prev, int hp)
+{
+    const int type = wm->wmtype <= 3 ? (int)wm->wmtype : 0;
+    dmd_bw_put_flag(bw, type != 0);           /* is_global */
+    if (!type)
+        return;
+    dmd_bw_put_flag(bw, type == 2);           /* is_rot_zoom */
+    if (type != 2)
+        dmd_bw_put_flag(bw, type == 1);       /* is_translation */
+    if (type >= 2) {
+        put_global_param(bw, type, 2, wm->wmmat, prev, hp);
+        put_global_param(bw, type, 3, wm->wmmat, prev, hp);
