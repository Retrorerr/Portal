+/* Read the H.264 slice header of the last slice in an access unit up to
+ * num_ref_idx_active_override_flag.  VA-API passes only the effective list
+ * lengths, not the PPS defaults or the override flag, yet MediaCodec parses
+ * every slice against the synthetic PPS: a default that differs from the
+ * stream's makes it misparse each P/B slice without an override and stop
+ * returning pictures.  A slice without an override shows the exact default.
+ * Returns the slice type (0 P, 1 B, 2 I, 3 SP, 4 SI) and sets *override, or
+ * -1 if the header cannot be read. */
+struct tva_br {
+    uint8_t buf[64];
+    unsigned len, pos;
+};
