+ * load as PrevGmParams when this picture is their primary reference.  Intra
+ * frames save the defaults (setup_past_independence). */
+static void
+tva_av1_hint_record(struct tva_codec *c, struct pipe_video_buffer *buffer,
+                    const VADecPictureParameterBufferAV1 *p)
+{
+    const unsigned frame_type = p->pic_info_fields.bits.frame_type;
+    const bool intra = frame_type == 0 || frame_type == 2;
+    struct tva_av1_hint *hint = NULL;
+    for (unsigned i = 0; i < c->av1_hint_count; i++) {
+        if (c->av1_hints[i].buffer == buffer) {
+            hint = &c->av1_hints[i];
+            break;
+        }
+    }
+    if (!hint) {
+        if (c->av1_hint_count == TVA_AV1_MAX_HINTS) {
+            memmove(&c->av1_hints[0], &c->av1_hints[1],
+                    sizeof(c->av1_hints[0]) * (TVA_AV1_MAX_HINTS - 1));
+            c->av1_hint_count--;
+        }
+        hint = &c->av1_hints[c->av1_hint_count++];
+    }
+    hint->buffer = buffer;
+    hint->order_hint = p->order_hint;
+    for (unsigned i = 0; i < 7; i++) {
