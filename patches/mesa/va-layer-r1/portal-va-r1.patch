+static unsigned
+tva_br_ue(struct tva_br *r)
+{
+    unsigned zeros = 0;
+    while (!tva_br_u(r, 1) && zeros < 32 && r->pos < r->len * 8)
+        zeros++;
+    return zeros >= 32 ? ~0u : ((1u << zeros) - 1) + tva_br_u(r, zeros);
