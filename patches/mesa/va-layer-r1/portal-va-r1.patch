+static unsigned
+tva_br_u(struct tva_br *r, unsigned n)
+{
+    unsigned v = 0;
+    while (n--) {
+        unsigned bit = 0;
+        if (r->pos < r->len * 8)
+            bit = (r->buf[r->pos >> 3] >> (7 - (r->pos & 7))) & 1;
+        r->pos++;
+        v = (v << 1) | bit;
+    }
+    return v;
+}
