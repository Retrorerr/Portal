From 25fee0fe6dbe35658ff651d66e581fbaf291b4fe Mon Sep 17 00:00:00 2001
From: portal <portal@localhost>
Date: Sat, 31 Oct 2026 15:58:59 +0000
Subject: [PATCH] egl: attach KGSL displays to the shim's DRM render device

Backport of lfdevs mesa 27.0 r1. With a DRM shim that resolves the KGSL fd to a render node, dri2_setup_device now finds the hardware EGLDevice instead of forcing the software one, so EGL clients see an accelerated device with a render node (Firefox's gfxtest reports MESA_ACCELERATED TRUE and DRM_RENDERDEVICE, which gate its VA-API probe). Without the shim drmGetDevice2 fails and the software device is used as before.
---
 src/egl/drivers/dri2/egl_dri2.c | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/src/egl/drivers/dri2/egl_dri2.c b/src/egl/drivers/dri2/egl_dri2.c
index 5cccae7..7b7a440 100644
--- a/src/egl/drivers/dri2/egl_dri2.c
+++ b/src/egl/drivers/dri2/egl_dri2.c
@@ -852,6 +852,22 @@ dri2_setup_device(_EGLDisplay *disp, EGLBoolean software)
    _EGLDevice *dev;
    int render_fd;
 
+#ifdef HAVE_LIBDRM
+   /* KGSL has no DRM device of its own, but a DRM shim (Portal's drmshim and
+    * fake /dev/dri) can make libdrm resolve the KGSL fd to a render node.
+    * Then attach the display to that hardware EGLDevice instead of the
+    * software one: clients such as Firefox read EGL_MESA_device_software as
+    * "not accelerated" and the render node as the device for VA-API.
+    * Without the shim, drmGetDevice2 fails and the software device stays. */
+   if (disp->Options.Kgsl && !software && dri2_dpy->fd_render_gpu >= 0) {
+      dev = _eglFindDevice(dri2_dpy->fd_render_gpu, false);
+      if (dev) {
+         disp->Device = dev;
+         return EGL_TRUE;
+      }
+   }
+#endif
+
    if (disp->Options.Kgsl || disp->Options.Zink)
       software = true;
 
