From eb9b5a9cf4e3bdc2d58ca6a86b189a95aea8ca0e Mon Sep 17 00:00:00 2001
From: portal <portal@localhost>
Date: Thu, 5 Nov 2026 11:48:44 +0000
Subject: [PATCH] freedreno: set the TP UBWC flag hint on Adreno 740

With it clear, UBWC surfaces sample as block garbage on SM8550 next to the
Android driver: panels and window shadows flicker, and browser icons turn
into white squares.
---
 src/freedreno/common/freedreno_devices.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/freedreno/common/freedreno_devices.py b/src/freedreno/common/freedreno_devices.py
index b1dfb7e..ee9b4b8 100644
--- a/src/freedreno/common/freedreno_devices.py
+++ b/src/freedreno/common/freedreno_devices.py
@@ -1190,7 +1190,9 @@ add_gpus([
         GPUId(chip_id=0xffff43050c01, name="Adreno X1-85"),
     ], A6xxGPUInfo(
         CHIP.A7XX,
-        [a7xx_base, a7xx_gen2],
+        # With the hint clear, UBWC surfaces sample as block garbage alongside
+        # the Android driver on SM8550 (seen with blob v676.77).
+        [a7xx_base, a7xx_gen2, GPUProps(enable_tp_ubwc_flag_hint = True)],
         num_ccu = 6,
         tile_align_w = 96,
         tile_align_h = 32,
-- 
2.56.0

