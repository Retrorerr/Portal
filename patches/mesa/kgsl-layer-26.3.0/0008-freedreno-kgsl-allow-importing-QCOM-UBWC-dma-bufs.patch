From 1e9dafbef7dde60479bb3f6028e694ccfc810387 Mon Sep 17 00:00:00 2001
From: Retrorerr <116828772+Retrorerr@users.noreply.github.com>
Date: Wed, 25 Nov 2026 00:15:03 +0000
Subject: [PATCH] freedreno/kgsl: allow importing QCOM UBWC dma-bufs

---
 src/gallium/drivers/freedreno/freedreno_resource.c | 6 +++++-
 src/gallium/drivers/freedreno/freedreno_screen.c   | 4 +++-
 src/gallium/drivers/freedreno/freedreno_screen.h   | 6 ++++++
 3 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/src/gallium/drivers/freedreno/freedreno_resource.c b/src/gallium/drivers/freedreno/freedreno_resource.c
index bcb6c2c..0458c58 100644
--- a/src/gallium/drivers/freedreno/freedreno_resource.c
+++ b/src/gallium/drivers/freedreno/freedreno_resource.c
@@ -1076,6 +1076,8 @@ fd_resource_modifier(struct fd_resource *rsc)
    if (screen->kgsl_dmabuf) {
       if (rsc->layout.tile_mode == 0 && !rsc->layout.ubwc_layer_size)
          return DRM_FORMAT_MOD_LINEAR;
+      if (rsc->layout.ubwc_layer_size && fd_kgsl_dmabuf_ubwc_supported(screen))
+         return DRM_FORMAT_MOD_QCOM_COMPRESSED;
 
       return DRM_FORMAT_MOD_INVALID;
    }
@@ -1562,7 +1564,9 @@ fd_resource_from_handle(struct pipe_screen *pscreen,
 
    if (screen->kgsl_dmabuf &&
        handle->modifier != DRM_FORMAT_MOD_LINEAR &&
-       handle->modifier != DRM_FORMAT_MOD_INVALID) {
+       handle->modifier != DRM_FORMAT_MOD_INVALID &&
+       !(handle->modifier == DRM_FORMAT_MOD_QCOM_COMPRESSED &&
+         fd_kgsl_dmabuf_ubwc_supported(screen))) {
       if (FD_DBG(LAYOUT))
          mesa_loge("kgsl cannot import non-linear modifier %" PRIx64,
                    handle->modifier);
diff --git a/src/gallium/drivers/freedreno/freedreno_screen.c b/src/gallium/drivers/freedreno/freedreno_screen.c
index 1275dfb..3f2d7ba 100644
--- a/src/gallium/drivers/freedreno/freedreno_screen.c
+++ b/src/gallium/drivers/freedreno/freedreno_screen.c
@@ -902,7 +902,9 @@ fd_screen_is_dmabuf_modifier_supported(struct pipe_screen *pscreen,
 
    if (screen->kgsl_dmabuf &&
        modifier != DRM_FORMAT_MOD_LINEAR &&
-       modifier != DRM_FORMAT_MOD_INVALID)
+       modifier != DRM_FORMAT_MOD_INVALID &&
+       !(modifier == DRM_FORMAT_MOD_QCOM_COMPRESSED &&
+         fd_kgsl_dmabuf_ubwc_supported(screen)))
       return false;
 
    return is_format_supported(pscreen, format, modifier);
diff --git a/src/gallium/drivers/freedreno/freedreno_screen.h b/src/gallium/drivers/freedreno/freedreno_screen.h
index d3276c8..b3863be 100644
--- a/src/gallium/drivers/freedreno/freedreno_screen.h
+++ b/src/gallium/drivers/freedreno/freedreno_screen.h
@@ -279,6 +279,12 @@ is_a6xx(struct fd_screen *screen)
    return screen->gen >= 6;
 }
 
+static inline bool
+fd_kgsl_dmabuf_ubwc_supported(struct fd_screen *screen)
+{
+   return is_a6xx(screen) && !screen->info->props.is_a702 && !FD_DBG(NOUBWC);
+}
+
 /* is it using the ir3 compiler (shader isa introduced with a3xx)? */
 static inline bool
 is_ir3(struct fd_screen *screen)
-- 
2.47.3

