+    return a.pixelDelta.x() * qint64(b.pixelDelta.x()) >= 0
+        && a.pixelDelta.y() * qint64(b.pixelDelta.y()) >= 0
+        && a.angleDelta.x() * qint64(b.angleDelta.x()) >= 0
+        && a.angleDelta.y() * qint64(b.angleDelta.y()) >= 0;
+}
+}
