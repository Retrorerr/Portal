+namespace {
+// Touch frames of one dispatch burst merge like pointer motion. The application
+// sees every press and release, and the latest position of every moved point.
+struct HeldTouchFrame {
+    QPointer<QWindow> window;
+    ulong time = 0;
+    const QPointingDevice *device = nullptr;
+    QList<QWindowSystemInterface::TouchPoint> points;
+    Qt::KeyboardModifiers modifiers;
+} heldTouch;
+
+bool holdTouchFrame(QWindow *window, ulong time, const QPointingDevice *device,
+                    const QList<QWindowSystemInterface::TouchPoint> &points,
+                    Qt::KeyboardModifiers modifiers)
+{
+    if (!window || !pointerEventBatchActive()
+            || !QCoreApplication::testAttribute(Qt::AA_CompressHighFrequencyEvents))
+        return false;
+    bool moved = false;
+    for (const auto &point : points) {
+        if (point.state != QEventPoint::Updated && point.state != QEventPoint::Stationary)
+            return false;
+        moved |= point.state == QEventPoint::Updated;
+    }
+    if (!moved)
+        return false;
+    bool sameIds = heldTouch.window == window && heldTouch.device == device
+        && heldTouch.modifiers == modifiers && heldTouch.points.size() == points.size();
+    for (qsizetype i = 0; sameIds && i < points.size(); ++i)
+        sameIds = heldTouch.points.at(i).id == points.at(i).id;
+    QList<QWindowSystemInterface::TouchPoint> merged = points;
+    if (sameIds) {
+        // A point that moved earlier in the burst still moved.
+        for (qsizetype i = 0; i < merged.size(); ++i) {
+            if (heldTouch.points.at(i).state == QEventPoint::Updated)
+                merged[i].state = QEventPoint::Updated;
+        }
+    } else {
+        flushTouchEventBatch();
+    }
+    heldTouch.window = window;
+    heldTouch.time = time;
+    heldTouch.device = device;
+    heldTouch.points = std::move(merged);
+    heldTouch.modifiers = modifiers;
+    return true;
+}
+}
+
+void flushTouchEventBatch()
+{
+    if (heldTouch.points.isEmpty())
+        return;
+    HeldTouchFrame frame = std::move(heldTouch);
+    heldTouch = {};
+    if (frame.window)
+        QWindowSystemInterface::handleTouchEvent(frame.window, frame.time, frame.device, frame.points, frame.modifiers);
