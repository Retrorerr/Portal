 qreal QWaylandScreen::devicePixelRatio() const
 {
+    if (mWaylandDisplay->usesFractionalScale() && zxdg_output_v1::isInitialized() && !mXdgGeometry.isEmpty()) {
+        QSize native = mGeometry.size();
+        // wl_output modes are untransformed; xdg-output is transformed.
+        const QSize logical = mXdgGeometry.size();
+        if ((native.width() > native.height()) != (logical.width() > logical.height()))
+            native.transpose();
+        const qreal sx = qreal(native.width()) / logical.width();
+        const qreal sy = qreal(native.height()) / logical.height();
+        // KWin rounds logical dimensions to pixels. Accept that bounded
+        // rounding error, but reject nonuniform or bogus compositor data.
+        const qreal tolerance = qMax(qreal(1) / logical.width(), qreal(1) / logical.height());
+        const qreal scale = qMax(sx, sy);
+        if (scale >= 1 && qAbs(sx - sy) <= tolerance
+                && qCeil(scale - tolerance) == mScale)
+            return qRound(scale * 120) / qreal(120);
+    }
     return qreal(mScale);
 }
 
