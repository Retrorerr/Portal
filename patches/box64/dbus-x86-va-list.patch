+#if defined(__aarch64__)
+static uint32_t dbus_va_arg(x64_va_list_t args)
+{
+    const void *slot;
+    if (args->gp_offset < X64_VA_MAX_REG) {
+        slot = args->reg_save_area + args->gp_offset;
+        args->gp_offset += 8;
+    } else {
+        slot = args->overflow_arg_area;
+        args->overflow_arg_area += 8;
+    }
+    uint32_t value;
+    memcpy(&value, slot, sizeof(value));
+    return value;
+}
+
+/* ARM passes va_list by value. On x86-64, libdbus advances the caller's
+ * list. Older SDL reads the reply types after the request's terminator.
+ * libdbus takes values by address and arrays also take a type and count,
+ * so all these parameters use general-purpose argument slots. */
+static void dbus_advance_va_list(int type, x64_va_list_t args)
+{
+    while (type != 0) { /* DBUS_TYPE_INVALID */
+        if (type == 'a') { /* DBUS_TYPE_ARRAY */
+            dbus_va_arg(args);
+            dbus_va_arg(args);
+        }
+        dbus_va_arg(args);
+        type = dbus_va_arg(args);
+    }
+}
+#endif
+
