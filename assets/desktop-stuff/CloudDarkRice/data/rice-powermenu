#!/usr/bin/env bash
# Portal version of ../../files/bin/rice-powermenu. Power button / Meta+Esc: full-screen rofi power menu
# over the blurred wallpaper. Portal has no logind, lock screen or suspend (Android owns those), so the
# menu keeps shut down / restart / log out; each goes through KDE's session manager so apps can save.
pkill -x rofi && exit 0   # pressing it again closes the menu
bash ~/.local/bin/rice-backdrop 2>/dev/null   # rebuilds the backdrop only if the wallpaper changed
up=$(uptime -p | sed 's/^up /uptime: /')
choice=$(printf '%s\n' "󰐥" "󰑓" "󰍃" |
  rofi -dmenu -i -format i -no-custom -p "" -mesg "$up" -theme ~/.config/rofi/powermenu.rasi) || exit 0
ksm() { qdbus6 org.kde.Shutdown /Shutdown "org.kde.Shutdown.$1"; }
case $choice in
  0) ksm logoutAndShutdown ;;
  1) ksm logoutAndReboot ;;
  2) ksm logout ;;
esac
