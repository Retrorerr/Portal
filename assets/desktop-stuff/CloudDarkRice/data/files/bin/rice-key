#!/usr/bin/env python3
"""Set a KDE global shortcut live through kglobalaccel (works on Plasma 6 Wayland,
where kglobalaccel lives inside kwin and edits to kglobalshortcutsrc are ignored).

  rice-key <component> <action> [key ...]     e.g. rice-key kwin "Window Close" Meta+Q Alt+F4
  rice-key <component> <action> none          clear it
  rice-key --get <component> <action>
  rice-key --who <key ...>                    which actions own these keys
  rice-key --register <component> <action> <friendly>

Uses python-dbus (installed by the packages step) so it also works inside Portal's
tawcroot engine. gdbus cannot send credentials there ("Operation not permitted"),
and qdbus6 has no scriptable way to pass QKeySequence lists.
"""
import re, subprocess, sys

MODS = {"meta": 0x10000000, "ctrl": 0x04000000, "alt": 0x08000000, "shift": 0x02000000}
NAMED = {"left": 0x01000012, "up": 0x01000013, "right": 0x01000014, "down": 0x01000015,
         "space": 0x20, "escape": 0x01000000, "esc": 0x01000000, "return": 0x01000004,
         "tab": 0x01000001, "backspace": 0x01000003, "print": 0x01000009,
         "meta": 0x01000022,   # bare Meta tap (only valid on its own)
         "pgup": 0x01000016, "pgdown": 0x01000017, "home": 0x01000010, "end": 0x01000011}
for i in range(1, 13):
    NAMED[f"f{i}"] = 0x01000030 + i - 1

def code(seq: str) -> int:
    parts = seq.split("+")
    key = parts[-1]
    if key == "" and seq.endswith("+"):      # "Meta++"
        key = "+"
    n = 0
    for m in parts[:-1]:
        n |= MODS[m.lower()]
    k = NAMED.get(key.lower())
    if k is None:
        if len(key) != 1:
            sys.exit(f"unknown key: {key}")
        k = ord(key.upper())
    return n | k

def action_id(comp, action):
    return [comp, action, "", ""]

try:
    import dbus
except ImportError:
    dbus = None

def interface():
    if dbus is None:
        return None
    bus = dbus.SessionBus()
    obj = bus.get_object("org.kde.kglobalaccel", "/kglobalaccel")
    return dbus.Interface(obj, "org.kde.KGlobalAccel")

def qdbus(method, *args):
    return subprocess.run(["qdbus6", "--literal", "org.kde.kglobalaccel", "/kglobalaccel",
                           f"org.kde.KGlobalAccel.{method}", *args],
                          check=True, capture_output=True, text=True).stdout.strip()

def who(key):
    iface = interface()
    c = code(key)
    if iface is not None:
        reply = iface.getGlobalShortcutsByKey(dbus.UInt32(c))
        return [(str(entry[2]), str(entry[0])) for entry in reply]
    # Fallback for a missing python-dbus: parse qdbus6 --literal's structs.
    out = qdbus("getGlobalShortcutsByKey", str(c))
    return [(m.group(3), m.group(1)) for m in re.finditer(
        r'\(ssssssaiai\) "([^"]*)", "([^"]*)", "([^"]*)", "([^"]*)"', out)]

if len(sys.argv) < 2:
    sys.exit(__doc__)

if sys.argv[1] == "--who":           # which actions own these keys
    for key in sys.argv[2:]:
        names = who(key)
        print(f"{key:18} " + ("; ".join(f"{comp}/{action}" for comp, action in names) or "-"))
    sys.exit()

if sys.argv[1] == "--get":
    iface = interface()
    keys = iface.shortcutKeys(action_id(sys.argv[2], sys.argv[3])) if iface is not None \
        else qdbus("shortcutKeys", str(action_id(sys.argv[2], sys.argv[3])))
    print(keys)
    sys.exit()

if sys.argv[1] == "--register":
    if dbus is None:
        sys.exit("rice-key --register needs python-dbus (run the packages step)")
    comp, action, friendly = sys.argv[2], sys.argv[3], sys.argv[4]
    interface().doRegister([comp, action, friendly, friendly])
    sys.exit()

comp, action, keys = sys.argv[1], sys.argv[2], sys.argv[3:]
keys = [] if keys in ([], ["none"]) else keys
if dbus is None:
    sys.exit("rice-key needs python-dbus (run the packages step)")
seqs = [(dbus.Array([code(k), 0, 0, 0], signature="i"),) for k in keys]
interface().setForeignShortcutKeys(action_id(comp, action),
                                   dbus.Array(seqs, signature="(ai)"))
