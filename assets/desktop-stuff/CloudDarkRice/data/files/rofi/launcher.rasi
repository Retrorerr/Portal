/* App launcher (Meta+Space / tap Meta). Reference 520px @1080p → 480 logical here. */
@import "colors.rasi"
configuration {
    modi: "drun";
    show-icons: false;
    display-drun: ">";
    drun-display-format: "{name}";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    hover-select: false;   /* pointer position must never change what Enter does */
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}
* {
    font: "Monofur Nerd Font 11";
    background-color: transparent;
    text-color: @fg;
}
window {
    location: center;
    anchor: center;
    width: 480px;
    background-color: @bg-dim;
    border: 0;
}
mainbox { children: [ inputbar, listview ]; spacing: 0; }
inputbar {
    children: [ prompt, entry ];
    background-color: @bg-alt;
    padding: 18px 22px;
    spacing: 14px;
    border: 0 0 3px 0;
    border-color: @bg-dim;
}
prompt {
    background-color: @yellow;
    text-color: @bg;
    padding: 5px 11px;
    font: "Monofur Nerd Font Bold 12";
    vertical-align: 0.5;
}
entry {
    placeholder: "...";
    placeholder-color: @grey;
    vertical-align: 0.5;
    cursor: text;
}
listview {
    lines: 6;
    fixed-height: true;
    scrollbar: false;
    spacing: 0;
}
element {
    padding: 10px 18px;
    border: 0 0 0 3px;
    border-color: transparent;
    cursor: pointer;
}
element selected.normal, element selected.active {
    background-color: @bg;
    border-color: @aqua;
}
element-text { background-color: inherit; text-color: inherit; vertical-align: 0.5; cursor: inherit; }
