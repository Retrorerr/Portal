// Compact fastfetch, after the reference: small logo, five keys, colour dashes
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "debian_small",
    "color": { "1": "red" },
    "padding": { "top": 1, "left": 1, "right": 4 }
  },
  "display": {
    "separator": " • ",
    "key": { "width": 9 },
    "color": { "output": "white", "separator": "magenta" }
  },
  "modules": [
    "break",
    { "type": "title", "key": "  usr", "keyColor": "magenta", "format": "{user-name}" },
    { "type": "os", "key": "  os", "keyColor": "green", "format": "{name} {arch}" },
    { "type": "kernel", "key": "  ker", "keyColor": "red", "format": "{release}" },
    { "type": "uptime", "key": "  upt", "keyColor": "yellow" },
    { "type": "packages", "key": "  pckg", "keyColor": "cyan" },
    "break",
    { "type": "custom", "format": "{#31}▬▬  {#32}▬▬  {#33}▬▬  {#34}▬▬  {#35}▬▬  {#36}▬▬" }
  ]
}
