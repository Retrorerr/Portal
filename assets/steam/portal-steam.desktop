[Desktop Entry]
Name=Steam
Comment=Application for managing and playing games on Steam
Exec=/usr/local/bin/steam %U
Icon=steam
Terminal=false
Type=Application
Categories=Network;FileTransfer;Game;
MimeType=x-scheme-handler/steam;x-scheme-handler/steamlink;
Actions=BigPicture;Library;Store;
PrefersNonDefaultGPU=true
X-KDE-RunOnDiscreteGpu=true
StartupWMClass=steam
X-Portal-Managed=true

[Desktop Action BigPicture]
Name=Big Picture
Exec=/usr/local/bin/steam steam://open/bigpicture

[Desktop Action Library]
Name=Library
Exec=/usr/local/bin/steam steam://open/games

[Desktop Action Store]
Name=Store
Exec=/usr/local/bin/steam steam://store
